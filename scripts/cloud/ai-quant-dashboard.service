[Unit]
Description=Soloquant - Dashboard (Streamlit)
After=network.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/soloquant
ExecStart=/home/ubuntu/soloquant/venv/bin/streamlit run src/ui/dashboard.py --server.port 8501 --server.headless true
Restart=always
RestartSec=5
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
