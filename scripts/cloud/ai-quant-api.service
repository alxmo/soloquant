[Unit]
Description=Soloquant - Model Sync API
After=network.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/soloquant
ExecStart=/home/ubuntu/soloquant/venv/bin/python -m src.api.model_sync
Restart=always
RestartSec=5
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
