[Unit]
Description=Soloquant - Trading Scheduler
After=network.target ai-quant-api.service

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/soloquant
ExecStart=/home/ubuntu/soloquant/venv/bin/python main.py scheduler
Restart=always
RestartSec=10
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
