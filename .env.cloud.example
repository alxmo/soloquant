# ═══════════════════════════════════════════════════════════════
# AI Fully-Automated US Stock Quant Trading System - Cloud Config Template
# ═══════════════════════════════════════════════════════════════
# For cloud server deployment: copy this file to .env and fill in real values
# Usage: cp .env.cloud.example .env

# ─── Deploy Mode (IMPORTANT!) ───
DEPLOY_MODE=cloud          # cloud | local (must be "cloud" on cloud server)

# ─── Alpaca (US Stock Trading) ───
ALPACA_API_KEY=your_alpaca_api_key
ALPACA_SECRET_KEY=your_alpaca_secret_key
ALPACA_BASE_URL=https://paper-api.alpaca.markets/v2

# ─── Finnhub (Financial Data) ───
FINNHUB_API_KEY=your_finnhub_api_key

# ─── FRED (Macroeconomic Data) ───
FRED_API_KEY=your_fred_api_key

# ─── FMP (Financial Data) ───
FMP_API_KEY=your_fmp_api_key

# ─── Qlib Data (can be disabled on cloud) ───
QLIB_DATA_DIR=./data/qlib_data
QLIB_ENABLED=false          # Disable Qlib training on cloud

# ─── Deep Learning (disabled on cloud) ───
TORCH_ENABLED=false         # No PyTorch on cloud

# ─── Model Sync API ───
MODEL_API_KEY=your_model_api_secret  # Model upload auth secret (set it yourself, must match local)
CLOUD_API_PORT=8000         # API service port
CLOUD_API_HOST=0.0.0.0      # Listen address

# ─── Realtime Quotes ───
REALTIME_ENABLED=true       # Enable realtime quotes on cloud
REALTIME_DATA_SOURCE=both   # alpaca | finnhub | both

# ─── System Settings ───
LOG_LEVEL=INFO
TRADING_MODE=paper          # paper | live (strongly recommend paper first)
MAX_POSITION_PCT=0.30       # Max position per stock: 30%
MAX_DAILY_LOSS=0.05         # Max daily loss: 5%
MAX_DRAWDOWN=0.15           # Max drawdown: 15%

# ─── Signal Settings ───
MAX_CANDIDATES=5
TOP_K_SIGNALS=5

# ─── LLM (Optional, not required on cloud) ───
# To enable AI chat on cloud, configure the same LLM as local
# LLM_DEFAULT=mymodel1
# LLM_MYMODEL1_ENDPOINT=https://api.xxx.com/v1
# LLM_MYMODEL1_API_KEY=your_key
# LLM_MYMODEL1_MODEL=model-name
