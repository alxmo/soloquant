# ═══════════════════════════════════════════════════════════════
# AI Fully-Automated US Stock Quant Trading System - Environment Config
# ═══════════════════════════════════════════════════════════════
# Usage: copy this file to .env and fill in your API keys

# ─── Alpaca (US Stock Trading) ───
# Sign up: https://app.alpaca.markets/
# Use Paper Trading keys first (simulated trading)
ALPACA_API_KEY=your_alpaca_api_key_here
ALPACA_SECRET_KEY=your_alpaca_secret_key_here
ALPACA_BASE_URL=https://paper-api.alpaca.markets/v2

# ─── Finnhub (Financial Data) ───
# Sign up: https://finnhub.io/register
FINNHUB_API_KEY=your_finnhub_api_key_here

# ─── Qlib Data Directory ───
QLIB_DATA_DIR=./data/qlib_data

# ─── LLM (Optional, for natural language interaction) ───
# v0.4.0+: multi-model config, supports any OpenAI-compatible API
#
# Naming convention: LLM_{NAME}_ENDPOINT / LLM_{NAME}_API_KEY / LLM_{NAME}_MODEL
# NAME is user-defined (case-insensitive); ENDPOINT + API_KEY + MODEL are all required.
# You can configure multiple models and pick the default via LLM_DEFAULT.
# Without a key, the system falls back to a rule-based engine — core features still work.
#
# Example config (uncomment and fill in your own info):
#
# Model 1
LLM_MYMODEL1_ENDPOINT=https://api.provider.com/v1
LLM_MYMODEL1_API_KEY=sk-your-api-key
LLM_MYMODEL1_MODEL=another-model-name
LLM_MYMODEL1_TEMPERATURE=0.5
LLM_MYMODEL1_MAX_TOKENS=8096

# Model 2 (multiple models supported)
# LLM_MYMODEL2_ENDPOINT=https://api.another-provider.com/v1
# LLM_MYMODEL2_API_KEY=sk-your-api-key
# LLM_MYMODEL2_MODEL=another-model-name
#
# # Default model (must be one of the NAMEs configured above)
LLM_DEFAULT=mymodel1

# ─── System Settings ───
LOG_LEVEL=INFO
TRADING_MODE=paper          # paper | live (strongly recommend paper first)
MAX_POSITION_PCT=0.30       # Max position per stock: 30%
MAX_DAILY_LOSS=0.05         # Max daily loss: 5%
MAX_DRAWDOWN=0.15           # Max drawdown limit: 15%

MAX_CANDIDATES=10           # Max candidate stocks discovered during research
TOP_K_SIGNALS=10            # Pick top 10 signals to go long

# ─── Crypto Settings ───
CRYPTO_ENABLED=true                          # Enable crypto module
CRYPTO_TRADING_ENABLED=false                 # Enable crypto trading (off by default, data-only)
CRYPTO_DATA_SOURCE=alpaca                    # Data source: alpaca | ccxt
# CRYPTO_TRADING_PAIRS=BTC/USD,ETH/USD,SOL/USD  # Custom pairs (comma-separated, default if empty)
CRYPTO_MAX_POSITION_PCT=0.20                 # Max position per coin: 20%
CRYPTO_MAX_DAILY_LOSS=0.08                   # Max daily loss: 8%
CRYPTO_MAX_DRAWDOWN=0.25                     # Max drawdown: 25%
CRYPTO_SINGLE_STOP_LOSS=0.10                 # Per-coin stop loss: 10%
CRYPTO_DAILY_TRADE_LIMIT=50                  # Max trades per day: 50
CRYPTO_MAX_TOTAL_POSITIONS=8                 # Max coins held: 8

# ─── Cloud Deployment Settings ───
CLOUD_HOST=your_host_ip
CLOUD_PORT=22
CLOUD_USER=root
CLOUD_PATH=/opt/soloquant
# Password auth (choose one)
# CLOUD_PASSWORD=your_password
# Key auth (recommended, choose one)
CLOUD_KEY_PATH=C:\path\to\your_ssh_key

# ─── FRED (Federal Reserve Economic Data) ───
# Sign up: https://fredaccount.stlouisfed.org/apikeys
FRED_API_KEY=your_fred_api_key_here
