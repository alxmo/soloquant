# ═══════════════════════════════════════════════════════════════
# AI Fully-Automated US Stock Quant Trading System - Local Config Template
# ═══════════════════════════════════════════════════════════════
# For high-spec local machines (training + backtesting)
# Usage: cp .env.local.example .env

# ─── Deploy Mode ───
DEPLOY_MODE=local           # cloud | local (set to "local" for local deployment)

# ─── Alpaca (US Stock Trading - optional locally) ───
ALPACA_API_KEY=your_alpaca_api_key
ALPACA_SECRET_KEY=your_alpaca_secret_key
ALPACA_BASE_URL=https://paper-api.alpaca.markets/v2

# ─── Finnhub (Financial Data) ───
FINNHUB_API_KEY=your_finnhub_api_key

# ─── FRED (Macroeconomic Data) ───
FRED_API_KEY=your_fred_api_key

# ─── FMP (Financial Data) ───
FMP_API_KEY=your_fmp_api_key

# ─── Qlib Data (enabled locally) ───
QLIB_DATA_DIR=./data/qlib_data
QLIB_ENABLED=true           # Enable Qlib locally

# ─── Deep Learning (enabled locally) ───
TORCH_ENABLED=true          # Enable PyTorch locally (GPU training)

# ─── Cloud Connection (IMPORTANT!) ───
CLOUD_API_URL=http://your_cloud_server_ip:8000   # Cloud API address
MODEL_API_KEY=your_model_api_secret              # Must match MODEL_API_KEY in cloud .env

# ─── System Settings ───
LOG_LEVEL=INFO
TRADING_MODE=paper
MAX_POSITION_PCT=0.30
MAX_DAILY_LOSS=0.05
MAX_DRAWDOWN=0.15

# ─── Signal Settings ───
MAX_CANDIDATES=10
TOP_K_SIGNALS=10

# ─── LLM (local config) ───
LLM_MYMODEL1_ENDPOINT=https://api.longcat.chat/openai/v1
LLM_MYMODEL1_API_KEY=your_llm_api_key
LLM_MYMODEL1_MODEL=LongCat-2.0
LLM_MYMODEL1_TEMPERATURE=0.7
LLM_MYMODEL1_MAX_TOKENS=8096
LLM_DEFAULT=mymodel1

# ─── SFTP Fallback Sync (optional) ───
# CLOUD_HOST=your_server_ip
# CLOUD_PORT=22
# CLOUD_USER=ubuntu
# CLOUD_PASSWORD=your_password
# CLOUD_PATH=/home/ubuntu/soloquant
